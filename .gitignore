# ================= Python =================
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
*.egg
.venv/
venv/
.env

# ================= Experiment outputs =================
# Anchored to repo root: an unanchored `exp/` would also swallow conf/exp/.
/exp/*
!/exp/.gitkeep

# Training logs (e.g. train_*.log at the root, nohup logs)
*.log
nohup.out

# Checkpoints and model files
*.ckpt
*.pth
*.pt
*.onnx

# Lightning / TensorBoard artifacts
lightning_logs/
tensorboard/
events.out.tfevents.*

# ================= Data =================
# Manifests contain machine-specific absolute paths; audio always lives
# outside this repo.
/data/*
!/data/.gitkeep

# ================= Simulation scratch =================
/simulation_tmp/
/simulation_train/
/simulation_validation/
.cache/

# ================= Editors / OS =================
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
